                "type": "text/javascript",
                "exec": [
                  "const t = pm.environment.get(\"token_alice\") || \"\";",
                  "if (t.length > 10) {",
                  "  const i = t.length - 3;",
                  "  pm.environment.set(\"token_tampered\", t.substring(0, i) + (t[i] === \"A\" ? \"B\" : \"A\") + t.substring(i + 1));",
                  "}"
                ]
              }
            },
