    {
      "name": "01 Scenarios (contrat 12)",
      "item": [
        {
          "name": "S1 alice cree une config -> 201",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{hubUrl}}/api/configs",
              "host": [
                "{{hubUrl}}"
              ],
              "path": [
                "api",
                "configs"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token_alice}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"application\": \"payment-api\",\n  \"environment\": \"prod\",\n  \"key\": \"db.pool.size\",\n  \"value\": \"20\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Statut 201\", () => pm.response.to.have.status(201));",
                  "const j = pm.response.json();",
                  "pm.test(\"version 1 et updatedBy alice\", () => { pm.expect(j.version).to.eql(1); pm.expect(j.updatedBy).to.eql(\"alice\"); });",
                  "pm.environment.set(\"configId\", j.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "S2 bob modifie la config -> 200, version 2",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
