                "{{hubUrl}}"
              ],
              "path": [
                "api",
                "configs",
                "{{configId}}"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token_bob}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"application\": \"payment-api\",\n  \"environment\": \"prod\",\n  \"key\": \"db.pool.size\",\n  \"value\": \"30\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Statut 200\", () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test(\"version 2, valeur 30, updatedBy bob\", () => { pm.expect(j.version).to.eql(2); pm.expect(j.value).to.eql(\"30\"); pm.expect(j.updatedBy).to.eql(\"bob\"); });"
                ]
