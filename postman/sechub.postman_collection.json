        {
          "name": "S5a carol lit /api/audit -> 200, voit S1 a S4",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{hubUrl}}/api/audit?size=50",
              "host": [
                "{{hubUrl}}"
              ],
              "path": [
                "api",
                "audit"
              ],
              "query": [
                {
                  "key": "size",
                  "value": "50"
                }
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token_carol}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Statut 200\", () => pm.response.to.have.status(200));",
                  "const c = pm.response.json().content;",
                  "const has = (a, ac, o) => c.some(e => e.actor === a && e.action === ac && e.outcome === o);",
                  "pm.test(\"alice CREATE_CONFIG ALLOWED\", () => pm.expect(has(\"alice\",\"CREATE_CONFIG\",\"ALLOWED\")).to.be.true);",
                  "pm.test(\"bob UPDATE_CONFIG ALLOWED\", () => pm.expect(has(\"bob\",\"UPDATE_CONFIG\",\"ALLOWED\")).to.be.true);",
                  "pm.test(\"bob DELETE_CONFIG DENIED\", () => pm.expect(has(\"bob\",\"DELETE_CONFIG\",\"DENIED\")).to.be.true);",
                  "pm.test(\"carol CREATE_CONFIG DENIED\", () => pm.expect(has(\"carol\",\"CREATE_CONFIG\",\"DENIED\")).to.be.true);"
                ]
              }
            }
          ]
        },
