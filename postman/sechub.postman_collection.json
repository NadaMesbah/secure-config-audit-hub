{
  "info": {
    "name": "Secure Config & Audit Hub",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Scenarios du contrat v1 (section 12). Lancer l'environnement sechub-local, puis Run collection. Les tokens durent 5 minutes."
  },
  "item": [
    {
      "name": "00 Tokens",
      "item": [
        {
          "name": "Token alice",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{keycloakUrl}}/realms/hub-realm/protocol/openid-connect/token",
              "host": [
                "{{keycloakUrl}}"
              ],
              "path": [
                "realms",
                "hub-realm",
                "protocol",
                "openid-connect",
                "token"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "password",
                  "type": "text"
                },
                {
                  "key": "client_id",
                  "value": "postman-client",
                  "type": "text"
                },
                {
                  "key": "username",
                  "value": "alice",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "{{alice_password}}",
                  "type": "text"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const prev = pm.environment.get(\"token_alice\");",
                  "if (prev) { pm.environment.set(\"token_expired\", prev); }",
                  "pm.test(\"Statut 200\", () => pm.response.to.have.status(200));",
                  "pm.environment.set(\"token_alice\", pm.response.json().access_token);"
                ]
              }
            }
          ]
        },
